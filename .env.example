# ══════════════════════════════════════════════════════════════════════════════
# DEPARTMENT AUTOMATION SYSTEM — PRODUCTION ENVIRONMENT CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════

# Application Environment
PORT=5000
NODE_ENV=production

# Database Configuration (PostgreSQL / Supabase / AWS RDS)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=college_results
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=8h

# CORS & Client URL
# In development: http://localhost:5173
# In production: https://dept-automation.meswcoepune.edu.in
CLIENT_URL=http://localhost:5173

# Email / SMTP (for password reset and alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@meswcoepune.edu.in
SMTP_PASS=your_app_password

# WhatsApp Notifications (optional, true/false)
WHATSAPP_ENABLED=true
